# 복사해서 .env 로 쓴다. 실제 값은 커밋하지 않는다.
# 키 없이 돌리려면 아래를 true 로 두면 된다 (FakeLLM: 첫 근거 문장을 그대로 인용).
CITEDESK_USE_FAKE_LLM=true

# 실제 모델을 쓸 때
# ANTHROPIC_API_KEY=
# CITEDESK_MODEL=claude-sonnet-5-5
# 단가(USD / 100만 토큰)는 공식 가격표를 보고 직접 채운다. 0 이면 비용 칸이 0 으로 찍힌다.
# CITEDESK_USD_PER_MTOK_IN=0
# CITEDESK_USD_PER_MTOK_OUT=0
